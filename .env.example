# Copie para .env e ajuste os valores. Nunca comite o .env real.
DB_URL=jdbc:postgresql://localhost:5432/junta_ai
DB_USER=junta_ai
DB_PASSWORD=junta_ai

JWT_SECRET=troque-esta-chave-em-producao-min-32-chars
JWT_ACCESS_EXP_MS=900000
JWT_REFRESH_EXP_MS=604800000

AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_CHAT_PATH=/v1/conversations/process

CORS_ALLOWED_ORIGINS=http://localhost:5173
# Azure/produção: CORS_ALLOWED_ORIGINS=https://junta-ai.vercel.app (sem wildcard).

GOOGLE_OAUTH_CLIENT_ID=
ACCESS_CODE_EXPIRATION_MINUTES=10

# Console de desenvolvimento: exporte SPRING_PROFILES_ACTIVE=local (ou dev).
# Para envio real, preencha as credenciais SMTP e o remetente autorizado.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
CONTACT_EMAIL_TO=contato.junta.ai@gmail.com

# Cota compartilhada entre Contato e Feedback, por instância (inclui tentativas inválidas).
PUBLIC_FORMS_RATE_LIMIT_PER_CLIENT=5
PUBLIC_FORMS_RATE_LIMIT_GLOBAL=100
PUBLIC_FORMS_RATE_LIMIT_WINDOW_SECONDS=600
PUBLIC_FORMS_RATE_LIMIT_MAX_CLIENTS=10000
